{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dinehop/restaurant-finder/main/schemas/hop.example.schema.json",
  "title": "Illustrative DineHop Hop",
  "description": "A conceptual example for documenting a multi-stop restaurant outing. This is not a public API or application export contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "stops"],
  "properties": {
    "schemaVersion": {
      "const": "1.0-example"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "plannedFor": {
      "type": ["string", "null"],
      "pattern": "^(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
    },
    "planningNote": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/stop"
      }
    }
  },
  "$defs": {
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "name", "visited", "wouldReturn"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "area": {
          "type": "string",
          "maxLength": 120
        },
        "cuisine": {
          "type": "string",
          "maxLength": 80
        },
        "plannedTime": {
          "type": ["string", "null"],
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
        },
        "privateNote": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "visited": {
          "type": "boolean"
        },
        "wouldReturn": {
          "type": ["boolean", "null"]
        }
      }
    }
  }
}
